[Unit]
Description=syncd: publish scanned notebook pages from ~/scans
After=network-online.target
Wants=network-online.target

[Service]
User=user
Environment=FOLDER=/home/user/scans STORAGE=/home/user/.local/share/syncd-scans STATUS_FILE=/home/user/.local/state/syncd-scans/status.json SETTLE_MS=5000
ExecStart=/usr/bin/node /opt/calm-syncd/syncd.mjs
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
