[Unit]
Description=syncd: pull music from the Mac into ~/Music
After=network-online.target
Wants=network-online.target

[Service]
User=user
EnvironmentFile=/home/user/.config/syncd/env
Environment=FOLDER=/home/user/Music STORAGE=/home/user/.local/share/syncd STATUS_FILE=/home/user/.local/state/syncd/status.json PUSH=0 ATOMIC=1 WIPE_GUARD=1
ExecStart=/usr/bin/node /opt/calm-syncd/syncd.mjs
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
